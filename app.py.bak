        """, unsafe_allow_html=True)

        col_demo, col_up = st.columns([1, 1])
        with col_demo:
            st.markdown(f"""
            <div style="background:{T['card']}; border:1px solid {T['border']}; border-radius:10px; padding:1.2rem; min-height:175px;">
                <h4 style="color:{T['text']} !important; margin:0 0 0.4rem !important;">Option 1: Instant Production Benchmark</h4>
                <p style="color:{T['text2']} !important; font-size:0.88rem; line-height:1.5; margin-bottom:1rem;">
                    Load the pre-packaged IBM Telco production dataset containing <strong>7,043 customer accounts</strong>.
