    if st.session_state["uploaded_df"] is None:
        st.markdown(f"""
        <div style="background:{T['card']}; border:1px solid {T['border']}; border-radius:12px; padding:2rem 2.2rem; margin-bottom:1.8rem;">
            <div style="display:flex; align-items:center; gap:1rem; margin-bottom:0.8rem;">
